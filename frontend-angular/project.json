{
  "name": "frontend-angular",
  "root": "frontend-angular",
  "projectType": "application",
  "targets": {
    "install": { "executor": "nx:run-commands", "options": { "command": "npm install", "cwd": "frontend-angular" } },
    "build": { "executor": "nx:run-commands", "options": { "command": "npx ng build", "cwd": "frontend-angular" }, "dependsOn": ["install"] },
    "test": { "executor": "nx:run-commands", "options": { "command": "npx ng test --watch=false --browsers=ChromeHeadless", "cwd": "frontend-angular" }, "dependsOn": ["install"] }
  }
}
